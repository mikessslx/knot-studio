# 1 = disable CPU-heavy endpoints (keep this for a public deployment)
# 0 = enable every endpoint (local or private network only)
PUBLIC_DEMO_MODE=1

# Set this to the repository URL when deploying, otherwise the button points at the GitHub homepage
PROJECT_REPO_URL=https://github.com/mikessslx/knot-studio

# Host path of data/, mounted read-only at /app/data by docker-compose (use ./data for local runs)
DATA_DIR=./data
